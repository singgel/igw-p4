How to Build SDE and p4 prog
========================================

SDE 9.3.1 
=======================

1. build p4 prog

	$SDE/pkgsrc/p4-build/configure  P4	_PATH=/root/p4code/p4src/bgw_switch.p4  P4_NAME=bgw_switch P4	_PREFIX=bgw_switch P4_VERSION=p4-16 P4_ARCHITECTURE=tna P4FLAGS="--	verbose 2 --create-graphs -g --auto-init-metadata" --with-tofino --prefix=$SDE_INSTALL


SDE 9.7.1 
=======================

1. build SDE
	
	./install-p4studio-dependencies.sh 
   
	use /tools/sde-profiles/switch-p4-16.yaml 
   
	./p4studio profile apply ./profiles/switch-p4-16.yaml   --bsp-path /sde/bf-reference-bsp-9.7.1.tgz

2. build p4 prog

	P4_PATH=/root/p4code/p4src/igw_switch.p4 
	P4_NAME=igw_switch

	cmake $SDE/p4studio/ \
		-DCMAKE_INSTALL_PREFIX=$SDE/install \
		-DCMAKE_MODULE_PATH=$SDE/cmake \
		-DP4_NAME=$P4_NAME \
		-DP4_PATH=$P4_PATH \
		-DP4_LANG=p4-16  \
		-DP4FLAGS="--verbose 2 --create-graphs -g"

SDE 9.7.3
=======================

1. build SDE
	
	./install-p4studio-dependencies.sh 
   
	use /tools/sde-profiles/switch-p4-16.yaml 
   
	./p4studio profile apply ./profiles/switch-p4-16.yaml   --bsp-path /root/sde/bf-reference-bsp-9.7.3.tgz

2. build p4 prog

	P4_PATH=/root/p4code/p4src/bgw_switch.p4 
	P4_NAME=bgw_switch

	cmake $SDE/p4studio/ \
		-DCMAKE_INSTALL_PREFIX=$SDE/install \
		-DCMAKE_MODULE_PATH=$SDE/cmake \
		-DP4_NAME=$P4_NAME \
		-DP4_PATH=$P4_PATH \
		-DP4_LANG=p4-16  \
		-DP4FLAGS="--verbose 2 --create-graphs -g"


