#!/bin/bash
 
IP_LIST="10.229.42.0 10.229.42.2 10.229.42.4 10.229.42.6 10.229.42.32 10.229.42.34 10.229.42.36 10.229.42.38 \
         10.229.42.8 10.229.42.10 10.229.42.12 10.229.42.14 10.229.42.40 10.229.42.42 10.229.42.44 10.229.42.46 \
         10.229.42.16 10.229.42.18 10.229.42.20 10.229.42.22 10.229.42.48 10.229.42.50 10.229.42.52 10.229.42.54 \
         10.229.42.24 10.229.42.26 10.229.42.28 10.229.42.30 10.229.42.56 10.229.42.58 10.229.42.60 10.229.42.62 \
         10.229.42.78"
RETRY_COUNT=1
TIMEOUT=3

ping_gz03_check() {
  for IP in $IP_LIST;do
    FAIL_COUNT=0
    for ((i=1; i<=($RETRY_COUNT); i++));do
        if ping -c 1 -W $TIMEOUT $IP >/dev/null; then
            break
        else
            let FAIL_COUNT++
        fi
    done

    if [ $FAIL_COUNT -eq $RETRY_COUNT ]; then
        echo "ping_state:255, desc: Ping $IP failure!"
        exit 0
    fi
  done
}

function main()
{
    ping_gz03_check
    echo "ping_state:0, desc: ok!"
}

main