#!/bin/bash

function perror()
{
    echo -e "$@"
    exit 0
}

function pnerror()
{
    echo -e "$@"
}

function pinfo()
{
    echo "Info: $@"
}

function check_str_null()
{
    if [ "$2" == "" ];then
        pnerror "$1"
    fi
}

function exit_str_null()
{
    if [ "$2" == "" ];then
        perror "$1"
    fi
}

DPC_CMD="/usr/local/bin/dpc table-info"

function vm_hostroute_mapping_monitor()
{   
    vm_hostroute_mapping_cap=`$DPC_CMD | grep vm_hostroute_mapping | awk -F " " '{print $6}'`
    exit_str_null "capacity_state:0, desc: normal capacity" $vm_hostroute_mapping_cap
    if [ "$vm_hostroute_mapping_cap" -ge "614400" ];then
         echo "capacity_state:255, desc: vm_hostroute_mapping capacity is $vm_hostroute_mapping_cap"
         exit 0
    fi
}

function vxlan_route_monitor()
{   
    vxlan_route_cap=`$DPC_CMD | grep vxlan_route.vxlan_route | awk -F " " '{print $6}'`
    exit_str_null "capacity_state:0, desc: normal capacity" $vxlan_route_cap
    if [ "$vxlan_route_cap" -ge "24000" ];then
         echo "capacity_state:255, desc: vxlan_route capacity is $vxlan_route_cap"
         exit 0
    fi
}

function route_ecmp_monitor()
{   
    route_ecmp_cap=`$DPC_CMD | grep route_ecmp| grep -v "route_ecmp_group_selector" | awk -F " " '{print $6}'`
    exit_str_null "capacity_state:0, desc: normal capacity" $route_ecmp_cap
    if [ "$route_ecmp_cap" -ge "18500" ];then
         echo "capacity_state:255, desc: route_ecmp capacity is $route_ecmp_cap"
         exit 0
    fi
}

function route_ecmp_group_selector_monitor()
{   
    route_ecmp_group_selector_cap=`$DPC_CMD | grep route_ecmp_group_selector | grep -v "route_ecmp_group_selector_get_member"| awk -F " " '{print $6}'`
