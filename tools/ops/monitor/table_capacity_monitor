function route_nexthop_monitor()
{   
    route_nexthop_cap=`$DPC_CMD | grep route_nexthop | awk -F " " '{print $6}'`
    exit_str_null "capacity_state:0, desc: normal capacity" $route_nexthop_cap
    if [ "$route_nexthop_cap" -ge "39400" ];then
         echo "capacity_state:255, desc: route_nexthop capacity is $route_nexthop_cap"
