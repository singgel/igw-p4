    exit_str_null "capacity_state:0, desc: normal capacity" $route_action_profile_cap
    if [ "$route_action_profile_cap" -ge "39400" ];then
         echo "capacity_state:255, desc: route_action_profile capacity is $route_action_profile_cap"
         exit 0
