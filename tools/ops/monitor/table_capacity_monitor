function main()
{
    vm_hostroute_mapping_monitor
    vxlan_route_monitor
    route_ecmp_monitor
    route_ecmp_group_selector_monitor
    route_action_profile_monitor
    route_nexthop_monitor
    tunnel_inner_rewrite_monitor
    echo "capacity_state:0, desc: normal capacity"
}

main
