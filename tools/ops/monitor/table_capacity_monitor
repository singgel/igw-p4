function tunnel_inner_rewrite_monitor()
{   
    tunnel_inner_rewrite_cap=`$DPC_CMD | grep tunnel_inner_rewrite | awk -F " " '{print $6}'`
    exit_str_null "capacity_state:0, desc: normal capacity" $tunnel_inner_rewrite_cap
    if [ "$tunnel_inner_rewrite_cap" -ge "39400" ];then
         echo "capacity_state:255, desc: tunnel_inner_rewrite capacity is $tunnel_inner_rewrite_cap"
         exit 0
