{% if action_spec.data %}
{% set actname = utils.actname_abbr(action_spec.name) %}
    if (action_id == {{gen_action_id_varname(action_spec.name)}}) {
        return {{prefix}}_{{tb_name}}_process_{{actname}}_entry_get(data_hdl,
            &data->data.{{actname}}_data);
    }
{% endif %}
{% endcall %}

    return -1;
}

int {{prefix}}_{{tb_name}}_entry_get
(
    netp4_bf_rt_t *netp4_bf_p, 
    {{tbkey_typename(tb_name)}} *key,
    {{prefix}}_{{tb_name}}_data_t *data
)
{
    bf_status status = BF_SUCCESS;

    /* Reset key and data before use */
    bf_rt_table_key_reset(bf_rt_table, &bf_rt_table_key);

    /**
     * Data reset is done without action-id, since the action-id is filled in by
     * the get function 
     */
    bf_rt_table_data_reset(bf_rt_table, *bf_rt_table_data);

    {{prefix}}_{{tb_name}}_key_setup(key, bf_rt_table_key);

    /* Entry get from hardware with the flag set to read from hardware */
    bf_rt_entry_read_flag_e flag = ENTRY_READ_FROM_HW;
    status = bf_rt_table_entry_get(bf_rt_table, netp4_bf_p->session,
        &netp4_bf_p->dev_tgt, bf_rt_table_key, bf_rt_table_data, flag);
    if (BF_SUCCESS != status) {
        return -1;
    }

    return {{prefix}}_{{tb_name}}_process_entry_get(bf_rt_table_data, data);
}

int 
{{prefix}}_{{tb_name}}_entry_delete(
    netp4_bf_rt_t *netp4_bf_p, const {{tbkey_typename(tb_name)}} *key)
{
    bf_status_t bf_status;

    /* Reset key before use */
    bf_rt_table_key_reset(bf_rt_table, &bf_rt_table_key);

    {{prefix}}_{{tb_name}}_key_setup(key, bf_rt_table_key);
    
    bf_status = bf_rt_table_entry_ret(bf_rt_table, 
        netp4_bf_p->session, &netp4_bf_p->dev_tgt, bf_rt_table_key);

    if (BF_SUCCESS != bf_status) {
        return -1;
    }

    bf_rt_session_complete_operations(netp4_bf_p->session);

    return 0;
}
