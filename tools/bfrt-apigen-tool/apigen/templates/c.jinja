            netp4_bf_p->dev_tgt,
            bf_rt_table_key,
            bf_rt_table_data);
    } else {
        bf_status = bf_rt_table_entry_mod(bf_rt_table, 
            netp4_bf_p->session, 
            netp4_bf_p->dev_tgt,
            bf_rt_table_key,
            bf_rt_table_data);
    }

    if (BF_SUCCESS != bf_status) {
        return -1;
    }

    bf_rt_session_complete_operations(netp4_bf_p->session);

    return 0;
